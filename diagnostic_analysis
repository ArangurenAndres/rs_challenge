diagnostic_data = {
    'test_users_count': len(test_users),
    'test_users_avg_interactions': test_user_stats['total_interactions'].mean(),
    'test_users_avg_days_since_last': days_since_last.mean(),
    'recommended_unique_items': len(set(all_recommended_items)),
    'most_recommended_item': recommended_counter.most_common(1)[0] if recommended_counter else None
}

